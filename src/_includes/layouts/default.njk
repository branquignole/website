<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="{{ '/styles/index.css' | url }}">
</head>
<body class="text-gray-200 font-sans">

  <!-- Background image -->
  <div class="fixed inset-0 -z-10 bg-cover bg-center" style="background-image: url('{{ '/assets/background.png' | url }}'); z-index: -10;"></div>

  <!-- Taskbar style Linux -->
  <div class="fixed top-0 left-0 w-full h-10 bg-gray-800 backdrop-blur-sm z-20 flex items-center justify-between px-4">

  <!-- Left: menu / logo -->
  <div class="relative flex items-center gap-2">
    <!-- Bouton -->
    <button id="appMenuBtn" class="hover:bg-gray-700/60 p-1 rounded flex items-center gap-1">
     <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6"> <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" /> </svg>
      <span class="font-mono text-gray-300 text-sm">Menu</span>
    </button>

    <!-- Menu déroulant -->
    <div id="appMenu" class="hidden absolute top-10 left-0 bg-gray-900/95 border border-gray-700 rounded-md p-3 w-56 font-mono text-sm text-gray-200 shadow-lg">
      <pre class="whitespace-pre leading-tight select-none">
  <span class="text-green-400 transition-all duration-200 ease-in-out transform scale-95">~/site</span>
  ├── <a href="{{ '/' | url }}" class="text-blue-400 hover:underline">about</a>
  ├── <a href="{{ '/research' | url }}" class="text-blue-400 hover:underline">research</a>
  ├── <a href="{{ '/teaching' | url }}" class="text-blue-400 hover:underline">teaching</a>
  ├── <a href="{{ '/recent_projects' | url }}" class="text-blue-400 hover:underline">projects</a>
  └── <a href="{{ '/publications' | url }}" class="text-blue-400 hover:underline">publications</a>
      </pre>
    </div>
  </div>

  <script>
    // Toggle du menu
    const btn = document.getElementById('appMenuBtn');
    const menu = document.getElementById('appMenu');
    document.addEventListener('click', (e) => {
      if (btn.contains(e.target)) {
        menu.classList.toggle('hidden');
      } else if (!menu.contains(e.target)) {
        menu.classList.add('hidden');
      }
    });
  </script>


    <!-- Center: user@host -->
    <div class="text-sm font-mono text-gray-100">
      johanne@research:~/site
    </div>

    <!-- Right: status icons + clock -->
      <div class="flex items-center gap-3 text-sm font-mono text-gray-100 tabular-nums">
        <div class="flex items-center gap-1 text-gray-400 text-xs">
          <span>📶</span>
          <span>🔋</span>
        </div>
        <span id="taskbar-clock">--:--</span>
      </div>


  </div>

  <!-- Main content -->
  <main class="pt-10">
    {{ content | safe }}
  </main>

  <!-- Clock script -->
  <script>
    const clockEl = document.getElementById('taskbar-clock');
    function updateClock() {
      const now = new Date();
      const h = now.getHours().toString().padStart(2,'0');
      const m = now.getMinutes().toString().padStart(2,'0');
      clockEl.textContent = `${h}:${m}`;
    }
    setInterval(updateClock, 1000);
    updateClock();
  </script>
    {% include "partials/footer.njk" %}
</body>
</html>
