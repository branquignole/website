<!DOCTYPE html>
<html lang="fr" data-theme="lofi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Linux Tiling Terminal Layout" }}</title>
  <link href="/styles/index.css" rel="stylesheet">
</head>
<body class="w-screen h-screen m-0 font-mono text-gray-100">

  <!-- Fond d'écran -->
  <div class="fixed inset-0 bg-cover bg-center" style="background-image: url('/assets/background.png'); z-index: -10;"></div>

  <!-- Grid tiling manager responsive -->
  <main class="grid grid-cols-[minmax(0,66.666%)_minmax(0,1fr)] grid-rows-4 gap-2 w-screen h-screen p-2 sm:grid-cols-1">
    {{ content | safe }}
  </main>
</body>
</html>


