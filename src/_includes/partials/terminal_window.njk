{% macro terminal_window(title, content, classes="", path="~/site") %}
<div class="terminal-window {{ classes }} flex flex-col rounded-lg shadow-lg overflow-visible border border-gray-700">
  <div class="terminal-bar flex items-center justify-between px-3 py-1 bg-gray-800">
    <span class="title text-sm font-semibold text-gray-100">{{ title }}</span>
    <div class="buttons flex gap-1">
      <span class="w-3 h-3 bg-red-500 rounded-full"></span>
      <span class="w-3 h-3 bg-yellow-400 rounded-full"></span>
      <span class="w-3 h-3 bg-green-500 rounded-full"></span>
    </div>
  </div>

  <div class="terminal-content p-3 text-sm bg-black/40 backdrop-blur-sm text-gray-100 flex-1 font-mono overflow-visible">
    <div class="terminal-prompt flex flex-wrap items-center gap-1 mb-1">
      <span class="text-cyan-400 font-semibold">user</span>
      <span class="text-gray-400">@</span>
      <span class="text-green-400 font-semibold">linux</span>
      <span class="text-gray-400">in</span>
      <span class="text-yellow-400 font-semibold">{{ path }}</span>
      <span class="text-gray-400">on</span>
      <span class="text-purple-400 font-semibold">🌿 main</span>
      <span class="text-gray-500">❯</span>
      <span class="text-green-400 font-bold">➜</span>
    </div>
    {{ content | safe }}
  </div>
</div>
{% endmacro %}
