{% macro project_browser(title, projects_collection, classes="") %}
<div class="terminal-window {{ classes }} flex flex-col rounded-lg shadow-lg overflow-hidden border border-gray-700">
  <div class="terminal-bar flex items-center justify-between px-3 py-1 bg-gray-800">
    <span class="title text-sm font-semibold text-gray-100">{{ title }}</span>
    <div class="buttons flex gap-1">
      <span class="w-3 h-3 bg-red-500 rounded-full"></span>
      <span class="w-3 h-3 bg-yellow-400 rounded-full"></span>
      <span class="w-3 h-3 bg-green-500 rounded-full"></span>
    </div>
  </div>

  <div class="terminal-content p-3 text-sm bg-white/20 backdrop-blur-sm text-gray-100 flex-1 overflow-auto font-mono">
    <ul class="ml-4 list-none space-y-1">
      {% for project in projects_collection %}
        <li class="flex items-center gap-2">
          {% if "projects/" in project.inputPath %}
            <span class="text-blue-400">📄</span>
          {% else %}
            <span class="text-yellow-400">📁</span>
          {% endif %}
          <a href="{{ project.url }}" class="hover:underline">
            {{ project.data.title or project.fileSlug }}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</div>
{% endmacro %}
